# Maintainer: GamerX <gamerx-os@gamerxeco-sys55.users.noreply.github.com>
# Meta package for the vanilla GamerX OS edition.
# Installing this and its deps reproduces the curated default install.

pkgname=gamerx-meta
pkgver=20260528
pkgrel=1
pkgdesc='GamerX OS — vanilla edition meta package (depends on the curated install set)'
arch=('any')
url='https://github.com/GamerXECO-sys55/gamerx-os'
license=('GPL-3.0-or-later')
groups=('gamerx')
provides=('gamerx-os')

