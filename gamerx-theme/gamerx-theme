#!/usr/bin/env python3
"""
gamerx-theme — single source of truth for GamerX OS theming.

Usage:
  gamerx-theme list <kind>
  gamerx-theme get <key>
  gamerx-theme set <key> <value>
  gamerx-theme show
  gamerx-theme apply
  gamerx-theme reset

<kind>: palettes | densities | animations | launchers | bars | notifications
<key>:  palette  | density   | animation  | launcher   | bar  | notification

State file: ~/.config/gamerx/state.toml
Palette dirs (search order): ~/.config/gamerx/palettes/, /usr/share/gamerx/palettes/

Renderers for individual components are loaded from /usr/share/gamerx-theme/renderers/
once the gamerx-shell package ships them (P3). Until then, `apply` only writes the
state file and prints the change.
"""
from __future__ import annotations

import argparse
import os
import sys
import tomllib
from pathlib import Path

try:
    import tomli_w
except Exception:
    tomli_w = None

VERSION = "0.1.0"

# -- Paths -------------------------------------------------------------------
HOME = Path.home()
USER_CFG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "gamerx"
STATE_FILE = USER_CFG_DIR / "state.toml"
USER_PALETTES = USER_CFG_DIR / "palettes"
SYSTEM_PALETTES = Path("/usr/share/gamerx/palettes")
RENDERER_DIR = Path("/usr/share/gamerx-theme/renderers")

# -- Defaults ----------------------------------------------------------------
DEFAULT_STATE = {
    "palette": "gamerx-purple",
    "density": "comfortable",
    "animation": "smooth",
    "launcher": "list",
    "bar": "default",
    "notification": "default",
    "icon_theme": "papirus",
    "wallpaper": "/usr/share/gamerx/wallpapers/default/01-aurora-3840x2160.svg",
}

VALID_DENSITIES = ("compact", "comfortable", "spacious")
VALID_ANIMATIONS = ("snappy", "smooth", "cinematic")
VALID_LAUNCHERS = ("list", "grid", "compact", "mac")
VALID_BARS = ("default", "minimal", "tight", "floating")
VALID_NOTIFICATIONS = ("default", "floating", "minimal")
VALID_KEYS = (
    "palette", "density", "animation", "launcher", "bar",
    "notification", "icon_theme", "wallpaper",
)

# -- Helpers -----------------------------------------------------------------

def err(msg: str, code: int = 1) -> None:
    print(f"gamerx-theme: error: {msg}", file=sys.stderr)
    sys.exit(code)


def warn(msg: str) -> None:
    print(f"gamerx-theme: warning: {msg}", file=sys.stderr)


def load_state() -> dict:
    if not STATE_FILE.exists():
        return dict(DEFAULT_STATE)
    try:
        with STATE_FILE.open("rb") as f:
            return {**DEFAULT_STATE, **tomllib.load(f)}
    except Exception as e:
        warn(f"could not read state file ({e}); using defaults")
        return dict(DEFAULT_STATE)


def save_state(state: dict) -> None:
    if tomli_w is None:
        err("python-tomli-w is required to write the state file. Install it first.")
    USER_CFG_DIR.mkdir(parents=True, exist_ok=True)
    tmp = STATE_FILE.with_suffix(".toml.tmp")
    with tmp.open("wb") as f:
        tomli_w.dump(state, f)
    tmp.replace(STATE_FILE)


def list_palettes() -> list[tuple[str, Path]]:
    out: dict[str, Path] = {}
    for d in (SYSTEM_PALETTES, USER_PALETTES):
        if d.is_dir():
            for p in sorted(d.glob("*.toml")):
                if p.name == "SCHEMA.toml":
                    continue
                pid = p.stem
                # User palettes shadow system ones
                if pid not in out or d == USER_PALETTES:
                    out[pid] = p
    return sorted(out.items())


def palette_meta(path: Path) -> dict:
    try:
        with path.open("rb") as f:
            data = tomllib.load(f)
    except Exception:
        return {}
    return data.get("meta", {})


# -- Commands ----------------------------------------------------------------

def cmd_show(_args) -> None:
    state = load_state()
    width = max(len(k) for k in state)
    for k in sorted(state):
        print(f"{k:<{width}}  {state[k]}")


def cmd_get(args) -> None:
    state = load_state()
    if args.key not in state:
        err(f"unknown key '{args.key}'. Valid keys: {', '.join(VALID_KEYS)}")
    print(state[args.key])


def cmd_set(args) -> None:
    if args.key not in VALID_KEYS:
        err(f"unknown key '{args.key}'. Valid keys: {', '.join(VALID_KEYS)}")

    # Validate value where applicable
    valid: tuple[str, ...] | None = {
        "density": VALID_DENSITIES,
        "animation": VALID_ANIMATIONS,
        "launcher": VALID_LAUNCHERS,
        "bar": VALID_BARS,
        "notification": VALID_NOTIFICATIONS,
    }.get(args.key)
    if valid and args.value not in valid:
        err(f"invalid value for {args.key}: '{args.value}'. Valid: {', '.join(valid)}")
    if args.key == "palette":
        ids = {pid for pid, _ in list_palettes()}
        if args.value != "auto" and args.value not in ids:
            err(f"unknown palette '{args.value}'. Try: gamerx-theme list palettes")

    state = load_state()
    old = state.get(args.key)
    state[args.key] = args.value
    save_state(state)
    print(f"{args.key}: {old} -> {args.value}")
    if not args.no_apply:
        apply_state(state)


def cmd_list(args) -> None:
    kind = args.kind
    if kind == "palettes":
        for pid, path in list_palettes():
            meta = palette_meta(path)
            name = meta.get("name", pid)
            mode = meta.get("mode", "?")
            default = " [default]" if meta.get("default") else ""
            print(f"  {pid:<24} {name:<24} ({mode}){default}")
    elif kind == "densities":
        for v in VALID_DENSITIES:
            print(f"  {v}")
    elif kind == "animations":
        for v in VALID_ANIMATIONS:
            print(f"  {v}")
    elif kind == "launchers":
        for v in VALID_LAUNCHERS:
            print(f"  {v}")
    elif kind == "bars":
        for v in VALID_BARS:
            print(f"  {v}")
    elif kind == "notifications":
        for v in VALID_NOTIFICATIONS:
            print(f"  {v}")
    else:
        err(f"unknown list kind '{kind}'. Try: palettes | densities | animations | launchers | bars | notifications")


def apply_state(state: dict) -> None:
    if not RENDERER_DIR.is_dir():
        warn(f"renderer directory {RENDERER_DIR} not found; "
             "state saved but not propagated. (gamerx-shell ships renderers in P3.)")
        return
    renderers = sorted(RENDERER_DIR.glob("*.sh"))
    if not renderers:
        warn("no renderers installed yet; state saved only.")
        return
    failures: list[str] = []
    for r in renderers:
        rc = os.system(f'/bin/sh "{r}"')
        if rc != 0:
            failures.append(r.name)
    if failures:
        warn(f"renderer failures: {', '.join(failures)}")


def cmd_apply(_args) -> None:
    apply_state(load_state())
    print("applied.")


def cmd_reset(_args) -> None:
    save_state(dict(DEFAULT_STATE))
    apply_state(load_state())
    print("reset to defaults.")


# -- Entrypoint --------------------------------------------------------------

def main() -> None:
    p = argparse.ArgumentParser(prog="gamerx-theme",
                                description=__doc__.strip().splitlines()[0])
    p.add_argument("--version", action="version", version=f"gamerx-theme {VERSION}")
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("show", help="print current state")
    s.set_defaults(func=cmd_show)

    s = sub.add_parser("get", help="print one state value")
    s.add_argument("key")
    s.set_defaults(func=cmd_get)

    s = sub.add_parser("set", help="change one state value (and apply)")
    s.add_argument("key")
    s.add_argument("value")
    s.add_argument("--no-apply", action="store_true", help="save only, don't propagate")
    s.set_defaults(func=cmd_set)

    s = sub.add_parser("list", help="list available values for a kind")
    s.add_argument("kind")
    s.set_defaults(func=cmd_list)

    s = sub.add_parser("apply", help="re-render every config from current state")
    s.set_defaults(func=cmd_apply)

    s = sub.add_parser("reset", help="reset to factory defaults")
    s.set_defaults(func=cmd_reset)

    args = p.parse_args()
    args.func(args)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
