# Maintainer: GamerX <gamerx-os@gamerxeco-sys55.users.noreply.github.com>
pkgname=gamerx-sddm-theme
pkgver=0.1.0
pkgrel=1
pkgdesc='SDDM greeter theme for GamerX OS — animated aurora, hyprlock-style password field, video/GIF backdrop support.'
arch=('any')
url='https://github.com/GamerXECO-sys55/gamerx-branding'
license=('GPL-3.0-or-later')
depends=('sddm' 'qt6-base' 'qt6-declarative' 'qt6-multimedia' 'qt6-svg')
makedepends=('git')

_branding_commit='HEAD'

if [[ -n "${GAMERX_LOCAL_SRC:-}" ]]; then
  source=()
else
  source=("git+https://github.com/GamerXECO-sys55/gamerx-branding.git#commit=${_branding_commit}")
  sha256sums=('SKIP')
fi

prepare() {
  if [[ -n "${GAMERX_LOCAL_SRC:-}" ]]; then
    rm -rf "${srcdir}/gamerx-branding"
    cp -r "${GAMERX_LOCAL_SRC}" "${srcdir}/gamerx-branding"
  fi
}

package() {
  local src="${srcdir}/gamerx-branding/themes/gamerx-sddm-theme"
  local dst="${pkgdir}/usr/share/sddm/themes/gamerx"
  install -dm755 "$dst"
  install -m644 "$src/Main.qml"          "$dst/Main.qml"
  install -m644 "$src/metadata.desktop"  "$dst/metadata.desktop"
  install -m644 "$src/theme.conf"        "$dst/theme.conf"
}
